# ==============================================================================
# OmniDoc-AI Backend Configuration
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Application Environment
DEBUG=False
PROJECT_NAME="OmniDoc-AI Document Intelligence"

# Database Configuration
# Production: PostgreSQL (Default port 5433 or standard 5432)
DATABASE_URL=postgresql://postgres:soykot@localhost:5433/omnidoc_ai
# SQLite Fallback (e.g. for lightweight local testing or offline environments):
# DATABASE_URL=sqlite:///storage/omnidoc.db

# Authentication & Security Secrets (REQUIRED IN PRODUCTION)
# Generate a strong key with: openssl rand -base64 32 or python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
# Wildcards are disabled by default for security.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload Security & Processing Boundaries
MAX_UPLOAD_SIZE_MB=100
MAX_PAGES_DIGITAL_PARSE=2000
OCR_PAGE_LIMIT_PER_BATCH=50

# Background Worker & Job Reliability
JOB_TIMEOUT_SECONDS=120
JOB_MAX_RETRIES=3

# Multi-Modal LLM Extraction Providers (Optional - Heuristic fallback active if keys absent)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash
